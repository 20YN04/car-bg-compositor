# Gemini API key — verplicht. Identificatie, synthese en inspecties draaien
# allemaal op gemini-3-pro-image.
GEMINI_NANO_BANANA_API_KEY=

# fal.ai API key — alleen nodig voor de lakmeting met MATTE.provider
# "fal-rmbg" (default) of "fal-birefnet". Zonder key: draai met
# --matte rembg (lokaal, gratis, vereist `pip3 install rembg`).
FAL_KEY=
