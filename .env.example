# Beide keys zijn OPTIONEEL — de default-pipeline (lokale rembg-matte +
# mathematische compositing op backgrounds/showroom.jpg) draait zonder.

# fal.ai API key — https://fal.ai/dashboard/keys
# Nodig voor de optionele stappen: auto-detectie (Florence-2), ruit-tint
# (SAM2), plaat-anonimisatie en de AI-kwaliteitscontroles. Zonder geldige key
# slaan die zichzelf over met een waarschuwing.
FAL_KEY=

# Gemini Nano Banana API key — alleen nodig met --genbg + --genbg-provider gemini
GEMINI_NANO_BANANA_API_KEY=
